# Copie este arquivo para .env e preencha os valores locais.
# NUNCA faça commit do arquivo .env com chaves reais.

# Porta da API Java
SERVER_PORT=8080

# Modo simulacao (true = segue o relogio recebido via RabbitMQ na fila zelo.sensor.relogio)
MODO_SIMULACAO=true

# Segredo JWT compartilhado com a API .NET (minimo 32 caracteres para HS256)
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=3600000

# Banco de dados (Padrao H2 em memoria para execucao imediata; altere para PostgreSQL se desejar)
DB_URL=jdbc:h2:mem:zelodb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# RabbitMQ (Requisito 5 - Opcao A)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Spring AI / LLM (OpenAI ou compativel como DeepSeek/Groq)
# Sem chave configurada, o sistema usa automaticamente o fallback por palavras-chave
OPENAI_API_KEY=sua-chave-aqui
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Integracoes externas (API .NET de Cuidado e API Python de Insights)
ZELO_CUIDADO_URL=http://localhost:5000
ZELO_INSIGHTS_URL=http://localhost:8000
